# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND (NESTJS)
# ============================================================================

# Cổng khởi chạy server API
PORT=3001

# Chuỗi kết nối PostgreSQL (Ví dụ dùng PostgreSQL cài trên máy hoặc Supabase / Neon / Render)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lau_mam_tram_ruoi?schema=public"

# Mã bí mật dùng để ký và giải mã JWT Token (giữ kín)
JWT_SECRET="lau_mam_tram_ruoi_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Client ID xác thực Google One Tap (lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
